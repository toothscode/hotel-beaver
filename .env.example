# ---- AI provider (shared across all hotels) ----
# Which provider the AI extractor uses: "claude" or "openai"
AI_PROVIDER=claude

# Claude / Anthropic
CLAUDE_AI_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5

# OpenAI (only needed if AI_PROVIDER=openai; requires `pip install openai`)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shared AI rate limit (sliding window)
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=1

# ---- Hotel-specific: Taj Lands End, Mumbai ----
HOTEL_ID=e1058dfa-fe44-4933-bb1b-85621258d217
HOTEL_URL=https://www.tajhotels.com/en-in/bookings/landing-page?hotelId=e1058dfa-fe44-4933-bb1b-85621258d217

# ---- Hotel-specific: The Leela Ambience Convention Hotel, Delhi (SynXis) ----
LEELA_CHAIN_ID=23514
LEELA_HOTEL_ID=3150
LEELA_CURRENCY=INR
# Leela uses a headless browser to clear Imperva. Set to 0 to show the browser
# window (helps if the challenge detects headless mode).
LEELA_HEADLESS=1

# ---- Hotel-specific: Vivanta Ahmedabad, SG Highway (Hudini, tenant=vivanta) ----
VIVANTA_HOTEL_ID=d361c899-95fe-434a-943e-bca0b3cdb9b2
VIVANTA_HOTEL_URL=https://www.vivantahotels.com/en-in/bookings/landing-page?hotelId=d361c899-95fe-434a-943e-bca0b3cdb9b2

# ---- Access safety (all hotels) ----
# Random delay between requests to the same site / bot-protection front.
SCRAPE_DELAY_MIN_S=3
SCRAPE_DELAY_MAX_S=6
# Hard ceiling on top of the delay.
SCRAPE_MAX_REQ_PER_MIN=12
SCRAPE_REQUEST_TIMEOUT_S=30
